  },
  "keywords": [
    "Vietqr",
    "Napas",
    "Casso",
    "Template"
  ],
  "author": "Casso",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vietqr/vietqr-node/issues"
  },
  "homepage": "https://github.com/vietqr/vietqr-node",
  "dependencies": {
    "axios": "^0.24.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "files": [
    "index.js",
    "lib",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
